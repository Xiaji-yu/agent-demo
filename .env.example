# ============================================================
#  NoneBot 服务端配置（反向 WebSocket 模式）
#  即：NapCat 主动连 NoneBot，NoneBot 作为 WS 服务端监听。
# ============================================================

# Driver：必须用支持 WebSocket Server 的驱动
DRIVER=nonebot.drivers.fastapi

# NoneBot 监听地址：NapCat 在局域网另一台机器时用 0.0.0.0，
# 并在防火墙里限制入站来源。
HOST=0.0.0.0
PORT=8080

# OneBot 适配器鉴权（与 NapCat 配置保持一致）
ONEBOT_ONEV11_ACCESS_TOKEN=123456
ONEBOT_ONEV11_SECRET=

# ============================================================
#  LLM（直接指定 base_url / model / key，不绑死供应商）
# ============================================================
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_API_KEY=502h2sIPIMdDHbuv7mkkrVNYRYYapam6hvRyzuWqne8tsWomMB3cZfXX9rHizx2Wm
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# 可选 fallback（主线路不通时自动切）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ============================================================
#  Search（博查 / Tavily，选一个填 key 即可；留空则不启用搜索 skill）
# ============================================================
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=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
SEARCH_MAX_RESULTS=5
SEARCH_LANG=zh-CN

# ============================================================
#  Database（M0 可留空用内存；M1+ 建议 PostgreSQL）
# ============================================================
DATABASE_URL=postgresql://qqagent:qqagent@127.0.0.1:5432/qqagent

# ============================================================
#  ACL
# ============================================================
# NoneBot pydantic v2 要求 SUPERUSERS 是 set[str]。
# 推荐写法：多个超管用逗号分隔，不带引号、不带空格。
# 留空或注释掉表示不限制超级用户。
SUPERUSERS=2224513919,10002
ALLOWED_GROUPS=

# ============================================================
#  NapCat HTTP 服务（用于跨机器发送文件）
# ============================================================
# NapCat 需开启 HttpService（默认端口 6099）。
# 若 NapCat 与 agent-demo 同机，可填 http://127.0.0.1:6099
# 若跨机器，填 NapCat 的局域网地址，如 http://192.168.1.3:6099
# 留空则尝试 file:// 发送（仅同机有效），失败则降级为文本
NAPCAT_HTTP_URL=

# ============================================================
#  Agent 配置
# ============================================================
AGENT_PREFIX=^[!！/]?ai\s*
AGENT_CONFIG=config.yaml
