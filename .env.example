# ============================================================
#  NoneBot 服务端配置（反向 WebSocket 模式）
#  即：协议端主动连 NoneBot，NoneBot 作为 WS 服务端监听。
# ============================================================
#  写法约定：KEY=VALUE 每行一条；值内如需 #（密码/URL fragment）请给值加引号
#  ——未加引号的「 #」视为行内注释起点（与 python-dotenv / scripts/deploy.py
#  的 check 口径一致）。

# Driver：必须用支持 WebSocket Server 的驱动
DRIVER=nonebot.drivers.fastapi

# NoneBot 监听地址：协议端在局域网另一台机器时用 0.0.0.0，
# 并在防火墙里限制入站来源。
HOST=0.0.0.0
PORT=8080

# OneBot 适配器鉴权（与协议端配置保持一致；留空 = 协议端也未设鉴权）
ONEBOT_ONEV11_ACCESS_TOKEN=
ONEBOT_ONEV11_SECRET=

# ============================================================
#  LLM（直接指定 base_url / model / key，不绑死供应商）
# ============================================================
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_API_KEY=...
LLM_MODEL=step-3.7-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# 多 provider 配置文件（独立 JSON，0600；首次启动从下面的旧键自动迁移）。
# 留空 = data/llm-providers.json。文件存在时以它为准；损坏则回落旧键。
AGENT_LLM_PROVIDERS_FILE=

# 候选模型池（逗号分隔）。条目语法：模型[@base_url[|api_key]]
#   step-3.7-flash                    用主端点/主 key
#   step-3@https://api.stepfun.com/v1 显式端点（仍用主 key）
#   llama@http://127.0.0.1:11434/v1|ollama  自带 key 的第三方端点
# 作用：一次请求内的降级顺序 = LLM_MODEL（活跃位）→ 刚被 /model 换下的旧主 →
# 池内其余（按此处的书写序）→ 下面的 LLM_FALLBACK_* 独立线。
# 留空 = 单模型部署（只有活跃位 + 独立备用线，与旧行为一致）。
# 改池需要重启才生效（池在进程启动时装配）；运行期只能切活跃位。
LLM_MODELS=

# 运行期切模型的探测超时（秒）：/model <名字> 与 web 写 LLM_MODEL 前会发一次
# 16 token 的探测请求，失败就不切换（防止打错模型名把机器人打哑）。0 = 不限时。
AGENT_MODEL_PROBE_TIMEOUT=20

# 可选 fallback（主线路不通时自动切）。注意：provider 文件存在时，
# LLM_FALLBACK_* 只作首次迁移源、运行期忽略（降级链由 provider 列表接管）。
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# 主备切换/恢复时私聊推送主人（SUPERUSERS）。持续降级按冷却周期提醒
# 「还在降级」，主模型恢复后再提醒一次；0/false = 关闭。
LLM_FALLBACK_NOTIFY=1
LLM_FALLBACK_NOTIFY_COOLDOWN=1800

# Web 只读总览（/agent-web）：**留空 = 整个 web 面不挂载**（fail-closed）。
# 访问时从 Authorization: Bearer 带 token；只读、无写接口。
# ---- 进程重启（/reboot 与 web 设置页「重启」按钮共用）----
# 外部重启命令（JSON argv 数组，白名单：systemctl/docker/supervisorctl/service，
# 必须是裸名、无 shell）。配了就走它（spawn 后退出让位）；未配则进程内 re-exec；
# re-exec 失败回退退出，由 supervisor（systemd Restart=always 或 compose
# restart: unless-stopped）拉起——裸 nohup 部署到这一步不会恢复。
# AGENT_REBOOT_CMD=["systemctl","restart","agent-demo"]
# AGENT_REBOOT_DELAY=2.0   # 回复发出到开始停机的宽限（秒）
# re-exec 入口文件（默认 bot.py，相对启动目录）；测试/特殊部署才需要改
# AGENT_REBOOT_ENTRY=bot.py
# 「重启完毕」回执文件位置（默认 data/reboot-notice.json；web 重启不发回执）
# AGENT_REBOOT_NOTICE_FILE=data/reboot-notice.json
AGENT_WEB_WRITE=
AGENT_WEB_TOKEN=
# 可选：源 IP 白名单（逗号分隔 CIDR/IP）。不配 = 只靠 token。
# 反代部署下 request.client.host 是反代地址，那种场景请在反代层做 IP 限制。
AGENT_WEB_ALLOW_CIDRS=
# 受控写入的改前快照目录（默认 data/backups/config，仅 AGENT_WEB_WRITE=1 时使用）
# AGENT_WEB_BACKUP_DIR=data/backups/config

# web 受控回写定位的 .env 路径（默认 CWD 下 .env，与 bot.py 的 load_dotenv 一致）。
# 正常部署无需设置；测试注入用
# AGENT_ENV_FILE=.env

# ============================================================
#  Search（博查 / Tavily，选一个填 key 即可；留空则不启用搜索 skill）
# ============================================================
# 搜索总开关（0 = 关闭；两个 search skill 直接返回"搜索功能已关闭"）
SEARCH_ENABLED=1
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=...
# 自定义搜索 API 端点（留空用 SEARCH_PROVIDER 默认；请求/响应格式沿用所选 provider）
SEARCH_BASE_URL=
SEARCH_MAX_RESULTS=5
SEARCH_LANG=zh-CN
# 多源 fallback 的全局墙钟上限（秒；脏值/非正值回退 25）——串行 fallback 最坏
# N×单源 timeout，不设总上限会把对话热路径拖住（全挂场景恰恰最该快速降级）
AGENT_SEARCH_TOTAL_TIMEOUT_S=25
# 多搜索源配置文件（0600；留空 = data/search-providers.json；web 模型页 M4 管理多源 + fallback）
AGENT_SEARCH_PROVIDERS_FILE=
# 2FA secret 文件（0600；留空 = data/2fa-secret.json；web 写面双因素认证，私聊 bot 发 /2fa 获取滚动码）
AGENT_2FA_SECRET_FILE=

# ============================================================
#  MediaWiki 在线直查（wiki_prts / wiki_blhx skill）
#  模型按需实时查 wiki（明日方舟/碧蓝航线），不建本地向量库；
#  检索结果按不可信数据围栏注入。详见 README「MediaWiki 在线直查」。
# ============================================================
# 启用的站点（逗号分隔：prts,blhx）；缺省 = 全部内置站点；none = 全关（不注册 skill）
AGENT_WIKI_SITES=prts,blhx
# 单次查询返回正文的字符预算（夹紧 1000~30000；脏值/非正值告警回退默认 9000）
AGENT_WIKI_BUDGET=9000
# 可选——精选子集落进向量知识库（kind="wiki"）：建 data/wiki_subset/<site>.txt
# （一行一个页面标题，# 注释），跑 python scripts/sync_wiki_subset.py
# （--dry-run 预览 / --prune 清理清单外 / --site <id> 单站；sha256 判重、变更自动替换）

# ============================================================
#  Database（M0 可留空用内存；M1+ 建议 PostgreSQL）
# ============================================================
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/dbname
# docker compose 的 PG 凭据（默认 qqagent/qqagent，与 README 文档一致；在 .env 覆盖）。
# **密码绝不提交进 git**；密码含 @ 等特殊字符时上面 DATABASE_URL 里必须 URL 编码
# （@ → %40）——asyncpg 按第一个 @ 分区，不编码会把密码截断、host 解析失败。
POSTGRES_USER=qqagent
POSTGRES_PASSWORD=qqagent

# ============================================================
#  Embedding（M4 长期记忆；留空则用本地 hash 降级，语义召回较弱）
#  可用任意 OpenAI 兼容 /embeddings 服务，例如智谱 GLM 或 SiliconFlow。
#  配了远程 API 时，启动会自动探测模型真实输出维度并按此维度建表，
#  EMBEDDING_DIM 仅在本地降级（无 key）时作为向量维度使用。
# ============================================================
# OpenAI 兼容**基址**：不含资源路径——/embeddings 由客户端自动拼接，写全了会 404
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=2048

# --- 示例：本地 Ollama（先 ollama pull bge-m3；key 随便填非空即可） ---
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3        # 必须与 ollama list 显示的名字完全一致：命名空间前缀（tisandman/ 等）是模型名的一部分，少一个字符就 404 → embedding 静默降级 hash → 语义检索全废
# EMBEDDING_DIM=1024
#
# 注意：更换向量模型后，旧事实的向量与新模型不同空间，召回会失真；
# 维度一致可不清库（慢慢过渡），维度不同则需 AGENT_MIGRATE_VECTOR=1 迁移（会清空），
# 详见 README「更换向量模型的弊端」。
# 单次 embeddings 请求最多多少条文本：多数服务有批量上限（DashScope 兼容模式为 10 条，
# 超限直接 400），长文档批量入库靠它分批；服务商无限制可调大以减少请求数
EMBEDDING_BATCH=10
# 单次 embeddings 请求的超时（秒）。**纯 CPU 跑本地 Ollama 时必须调大**：
# bge-m3 在 4 核 CPU 上，一批 10 条约需 40s，默认 30s 会让大文件导入**每一批**
# 都 ReadTimeout（表现为 /kb samples 每个切块都「失败」且日志原因为空）。
# 经验值：CPU 推理用 180~300，并把 EMBEDDING_BATCH 降到 2~4 缩短单次耗时。
EMBEDDING_TIMEOUT=30
# 向量维度迁移（有数据丢失风险）：当模型输出维度与库中已有 vector 列不一致时，
# 默认只告警不动库。确认可接受清空 facts/kb_chunks 后再设为 1 以启用 TRUNCATE+ALTER。
AGENT_MIGRATE_VECTOR=0

# ============================================================
#  成本预算（M7：用量按日累计 + 可选硬闸门）
# ============================================================
# 每日 LLM token 预算（prompt+completion 合计）：0 = 只记录不限流
AGENT_BUDGET_DAILY_TOKENS=0
# 超预算是否硬拦截：1 = 聊天/蒸馏直接返回预算提示；0 = 只打 WARNING 放行
AGENT_BUDGET_ENFORCE=0
# 可选单价（元/百万 token）：配置后 /status 显示当日估算成本
AGENT_PRICE_PROMPT_PER_M=
AGENT_PRICE_COMPLETION_PER_M=
# 用量账本目录（默认 data/budget，相对路径按 CWD 解析；部署请用绝对路径）
AGENT_BUDGET_DIR=data/budget

# ============================================================
#  日志归档（M7：按天落盘轮转；含聊天明文，已 gitignore 绝不入库）
# ============================================================
# 保留天数，超过自动清理；0 = 关闭落盘（注意运行时真实留存约为 N+1 天）
AGENT_LOG_KEEP_DAYS=14
# 日志目录（默认 data/logs，相对路径按 CWD 解析）。**指到仓库内其它路径时
# data/logs/ 的 gitignore 保护即失效，聊天明文可能被 git 跟踪，请务必谨慎。**
AGENT_LOG_DIR=data/logs

# ============================================================
#  ACL
# ============================================================
# NoneBot pydantic v2 要求 SUPERUSERS 是 set[str]。
# 推荐写法：多个超管用逗号分隔，不带引号、不带空格。
# 留空或注释掉表示没有超级用户（fail-closed：工作区/管理类技能全部不可用）。
# ⚠ 填**你自己**的 QQ 号：这个模板是给所有部署者用的，预填任何人的号都等于
# 把那个陌生人设成你部署的管理员（超管可执行 run_shell/proc_kill//reboot）。
SUPERUSERS=
ALLOWED_GROUPS=
# ↑ 留空 = 没有任何群被允许（fail-closed，bot 在所有群都不响应聊天/群命令）。
# 群统计与原文归档同键同语义：**空集 = 不采集/不归档**（启动日志有 WARNING）。

# 用户黑名单（逗号分隔 QQ 号）：命中者所有入口**静默拒绝**——不回复任何内容，
# 只记 WARNING 日志（不告诉对方他被拉黑）。群聊、私聊、admin 指令全部生效；
# SUPERUSERS 豁免（主人永远可用，防误拉黑把自己锁死）。留空 = 不启用。
# 与 ALLOWED_GROUPS 同为启动时读取，改后需重启进程。
BLOCKED_USERS=

# 自定义唤醒词（半角逗号分隔）——群聊触发的**唯一文本方式**（另一种是 @机器人）。
# 消息以任一唤醒词开头即触发（不区分大小写、无词界）：若把 `ai` 列为唤醒词，
# 则 "airpods 值得买吗" 这类 ai 开头的群消息也会触发（REVIEW-679c9b3..c472e56 M2），
# 所以默认值不含它；确有需要再自行追加。
# 旧的 ai / !ai / /ai 前缀正则已移除，配了也不再生效。私聊始终直接对话，不走唤醒词。
AGENT_WAKE_WORDS=小助手,助手

# ============================================================
#  文件发送（协议端 HTTP 上传，跨机器推荐）
# ============================================================
# 需协议端开启 HTTP 服务（端口见协议端自身配置，常见 3000 / 6099）。
# 若协议端配置了 access_token，需在此填入以通过验证。
# 留空则降级为 OneBot base64:// 协议。
# 注：变量名沿用历史前缀，实际对接任一 OneBot v11 兼容实现均可。
NAPCAT_HTTP_URL=
NAPCAT_HTTP_TOKEN=

# ============================================================
#  Agent 配置
# ============================================================
AGENT_CONFIG=config.yaml
# 人格文件目录（默认 agentcore/personas/，通常无需设置）
# PERSONAS_DIR=
# 默认人格名（覆盖 personas md 的 default 字段；本地覆盖用，通常无需设置）
# PERSONAS_DEFAULT=
# 动态安装的 skill YAML 目录（默认 data/skills，通常无需设置）
# AGENT_SKILLS_DIR=data/skills

# ============================================================
#  LLM 沙箱工作区（fs_* / run_command 的根目录，默认 data/workspace）
# ============================================================
WORKSPACE_DIR=data/workspace

# ------------------------------------------------------------
#  SSH 远程只读诊断（ssh_run 技能，仅管理员）
#  未配置 AGENT_SSH_HOSTS = 整个功能关闭（fail-closed）。
#  远程命令由代码写死（free/meminfo/top/ps/disks/dmesg/logread 等只读动作），
#  LLM 无法自定义命令，也无法指定 host——只有 .env 登记过的 alias 可登录。
#  凭据：每个 alias 支持 AGENT_SSH_KEY_<ALIAS>（私钥路径，推荐）或
#  AGENT_SSH_PASSWORD_<ALIAS>（经环境变量注入 sshpass，不进 argv/日志）；
#  <ALIAS> 为 alias 的大写形态（myserver → MYSERVER）。
# ------------------------------------------------------------
# AGENT_SSH_HOSTS=myserver=root@10.0.0.2:22
# AGENT_SSH_KEY_MYSERVER=/home/you/.ssh/id_ed25519
# AGENT_SSH_PASSWORD_MYSERVER=
# known_hosts 位置（默认 data/ssh/known_hosts；首次连接 TOFU 登记，之后严格校验）
# AGENT_SSH_KNOWN_HOSTS=data/ssh/known_hosts

# ------------------------------------------------------------
#  Home Assistant 智能家居（ha_state / ha_control 技能，仅管理员）
#  三项都配置才启用，缺任一 = 整个功能关闭（fail-closed）。
#  AGENT_HA_BASE_URL 必须是最终地址（http/https，不带凭据/查询串）；
#  技能不跟随重定向，反代请直接填对外地址。
#  token 为 HA「长期访问令牌」，只写进 .env，不进日志/返回值/Web 写面。
#  AGENT_HA_ENTITIES 是实体登记表：读与写都只认这里列出的 entity_id。
#  lock/cover/alarm_control_panel/climate 的控制需二次确认（确认码 120s）。
# ------------------------------------------------------------
# AGENT_HA_BASE_URL=https://ha.example.com
# AGENT_HA_TOKEN=eyJhbGciOi...
# AGENT_HA_ENTITIES=light.living_room,switch.desk_plug,sensor.living_temp

# ============================================================
#  多模态识图（图片以 data URI / https URL 传给模型）
#  需接入支持视觉的 OpenAI 兼容模型（如 qwen-vl）；DeepSeek 文本模型不适用。
#  开启后还支持：最近图片记忆（先发图后追问）、引用/转发消息自动解析。
# ============================================================
AGENT_VISION=0
# 识图单图预算（KB，base64 前的原始大小；与 20MB 落盘上限解耦）
AGENT_VISION_MAX_IMAGE_KB=5120
# 识图单条消息总预算（KB）
AGENT_VISION_TOTAL_KB=8192
# 识图载荷是否贯穿 tool-loop：默认 1（模型首步调工具、终稿出自第二步及以后时，
# 每一步请求仍带图——否则终稿步的模型看不到图，只能回「看不到图片具体内容」，
# 线上实测 2026-10-02 群聊带图提问触发首步搜索后复现）。置 0 恢复
# 「首次 LLM 调用后降级为纯文本」的旧成本优化（token/请求体随步数放大的场景才需要）。
AGENT_VISION_KEEP_IN_LOOP=1
# at 段解析诊断（默认 0）：置 1 后每条**群消息**都会往日志打一行
# 「[raw-dump]」，含协议端原始 CQ 码（raw_message）、适配器处理后的段、self_id、
# to_me 与被引用消息信息。用于定案「@ 到底指向谁」——客户端/协议端送来的 at 与
# NoneBot 实际收到的段是否一致（_check_reply/_check_at_me 会删段）。另外每条
# **未触发**的群消息会补一行「[trigger-miss]」：路由层实际看到的 at 目标列表、
# 唤醒词命中、to_me、是否有 reply 与截断后的原文——按 msg_id 与 [raw-dump] 对上
# 后即可区分「协议端根本没上报 @bot」与「路由漏判」（2026-10-19 线上排查）。
# **大群日志量可观，排查完请置回 0**（线上疑云 2026-10-13：群里 @bot 无响应，见 BACKLOG §6.7）。
AGENT_DEBUG_RAW_DUMP=0
# 日志正文开关（默认 1）：置 0 后 [msg]/[reply]/[trigger-miss]/[raw-dump]
# 等日志只记 text_len、段类型与用户/群 id，不落消息正文（含被引用原文）。
# 排查类日志（AGENT_DEBUG_RAW_DUMP）同样受此开关约束。该键不可经 web 改写，
# 需要变更请编辑 .env 后重启。
AGENT_LOG_CONTENT=1
# 最近图片记忆：TTL 秒数与缓冲条目数（私聊"先发图后追问"用）
# 注：缓冲区在 import 时按 env 构造，运行期改这几个值需重启才生效
AGENT_RECENT_IMAGE_TTL=180
AGENT_RECENT_IMAGE_ENTRIES=32
# 群聊是否**无差别**复用「最近图片」：默认 0（群里多人多话题，历史图会被当成
# 当前上下文而答非所问）；置 1 才开启。本条消息带引用(reply)或引用/转发含图时
# 无论该开关如何都不复用。
# 注：用户明确问「这张图 / 刚才那张图」时，即使为 0 也会按群上下文里同一发送者
# 的 message_id 回捞原图（不需手动引用）；普通「你怎么看」不会自动塞旧图。
AGENT_RECENT_IMAGE_GROUP=0
# 管理员图片落盘目录容量配额（MB），超配额按最旧淘汰
AGENT_MEDIA_QUOTA_MB=200
# 图片下载域名白名单（https 前提下生效；逗号分隔后缀）
# 注意：置空**不再**表示"允许任意 https 域名"（那会让一个空变量整体关闭 SSRF 防护），
# 空值会回落到默认 QQ 图床白名单；确需放开请显式设置下面的开关。
AGENT_IMAGE_HOSTS=qpic.cn,qq.com,qq.com.cn,gtimg.cn,gtimg.com,idqqimg.com,qlogo.cn
# 显式放开域名白名单（默认 0）。置 1 后允许任意 https 域名，
# 但仍会做 IP 层校验：解析到内网/回环/链路本地/保留段一律拒绝。
AGENT_IMAGE_ALLOW_ANY_HOST=0

# ============================================================
#  消息防抖（秒）：同一会话窗口内无新消息才处理，用于合并"半句话+补充"
#  0 关闭；默认 3 秒
# ============================================================
AGENT_DEBOUNCE=3

# ============================================================
#  群聊上下文（0 关闭；默认开启）
#  记录群里最近消息（仅内存、不落库），被 @/唤醒时作为语境注入，
#  用于「他们在聊什么/这句话什么意思」这类请求。
# ============================================================
AGENT_GROUP_CONTEXT=1
AGENT_GROUP_CONTEXT_LINES=10
# 同上：进程内缓冲区，改动需重启生效
AGENT_GROUP_CONTEXT_TTL=900

# ============================================================
#  公共知识库（M5，成长型 RAG）
#  每天把新增对话蒸馏成「与个人无关」的通用知识条目入库，供所有会话检索；
#  也会做 PII 掩码与指令性内容过滤，避免公共库变成注入传播通道。
#  其余参数见 config.yaml 的 rag: 段。
# ============================================================
AGENT_KB_ENABLED=1
# 单来源块数上限（覆盖 config.yaml 的 rag.max_chunks_per_source）。
# 大文件会自动切块后逐份入库（不再按此上限砍尾）；仅单份切块内部超上限才会
# 丢弃并打 WARNING，脚本/命令的汇总里也会给出丢弃总数。
AGENT_KB_MAX_CHUNKS_PER_SOURCE=1000
# 导入前的体积预检：`/kb samples` 先估算「本次将新入库」的体量，超过任一阈值就
# 不启动，回一句预估并要求再发 `/kb samples confirm` 才真正开始。
# 0 = 关闭该维度。默认 50MB / 20000 块：本地 CPU embedding 每块约数秒，几万块
# 要跑几十小时，先问一句比白跑几小时强（云端 embedding 通常几分钟）。
AGENT_KB_SAMPLES_CONFIRM_MB=50
AGENT_KB_SAMPLES_CONFIRM_CHUNKS=20000
# 蒸馏 prompt 的长度上限（字符），覆盖 config.yaml 的 rag.distill_*（env 优先）：
# 单条消息超过 per_message_cap 会截断并记 WARNING；transcript 总长超过
# total_cap 停止收集，未收集的消息下一轮续蒸（不丢）。
AGENT_KB_DISTILL_PER_MESSAGE_CAP=1000
AGENT_KB_DISTILL_TOTAL_CAP=20000
# 每日蒸馏时间（5 段 cron：分 时 日 月 周）；设置后覆盖 config.yaml 的 digest_cron
AGENT_KB_DIGEST_CRON=0 3 * * *
# 私聊默认不进蒸馏（公共库对所有人可见，私聊用户对"内容被沉淀"没有预期）；
# 确认接受跨上下文信息流时才设为 1
AGENT_KB_DISTILL_PRIVATE=0
# 额外的脱敏词表（逗号分隔的人名/昵称）：蒸馏前原样替换为占位符。
# 也可不放环境变量，改用 data/privacy/names.txt（一行一个，不入库）；
# 未登录的人名/昵称仍可能漏网，定期把实际出现的称呼补进词表
AGENT_KB_PII_TERMS=

# ============================================================
#  记录保全（防删库/防误操作）
#  1) 聊天记录 JSONL 归档：落在 DB 之外的文件里，滚动保留 N 天；
#     蒸馏会把它和数据库并集作为输入，库被清空也能继续沉淀知识。
#  2) 每日数据库备份：优先用 pg_dump（宿主机没有就用 PG 容器里的），
#     失败自动降级为 asyncpg 全表 JSONL 导出；保留最近 N 份。
#  恢复：python scripts/backup_db.py list / verify <file> / restore <file> --yes
# ============================================================
AGENT_ARCHIVE_ENABLED=1
AGENT_ARCHIVE_DIR=data/archive
AGENT_ARCHIVE_KEEP_DAYS=7
AGENT_BACKUP_ENABLED=1
AGENT_BACKUP_DIR=data/backups
AGENT_BACKUP_KEEP=7
AGENT_BACKUP_CRON=30 3 * * *
# PG 容器名（宿主机没有 pg_dump 时用它执行备份/恢复）
PG_CONTAINER=agent-demo-db-1
# 异地镜像目录（强烈建议填写：挂载的第二块盘 / NAS / 同步盘）。
# 备份与原库在同一块盘时，挡得住误删、挡不住盘坏。留空 = 不镜像。
AGENT_BACKUP_MIRROR_DIR=
# 备份加密（可选，age recipient-only）：置 age 后 pg_dump 流直接经 age 加密，
# 产物为 `<tag>-<date>.sql.gz.age`；bot 只持公钥，私钥应离线保管。
# 开启后**不会回退 JSONL**（避免悄悄落一份明文全库），宿主机需有 `age` 命令。
# 恢复：先 `age -d -i <私钥文件> <file>.age > <file>` 解出 .sql.gz，再
# `python scripts/backup_db.py restore <file> --yes`。
AGENT_BACKUP_ENCRYPT=
# age 公钥（age1...）；AGENT_BACKUP_ENCRYPT=age 时必填
AGENT_BACKUP_AGE_RECIPIENT=

# ============================================================
#  工具集补充配置
# ============================================================
# fetch_url 的 SSRF 防护：默认放行透明代理（fake-IP）常用的 198.18.0.0/15，
# 该段只在本机代理内可路由；置空则严格模式（只允许真正的公网地址）。
AGENT_FETCH_ALLOW_RANGES=198.18.0.0/15
# log_tail 允许读取的日志目录（逗号分隔，默认 /var/log）；只读、仅管理员
AGENT_LOG_ALLOWLIST=/var/log

# ============================================================
#  Agent 权限级别（仅调节 SUPERUSERS 的能力上限）
#  服务器操作类技能（运维/工作区/动作类/ssh/db/shell）只对 SUPERUSERS 开放：
#  普通用户的工具 schema 里没有这些技能，任何级别都不可见、调用得 unknown。
#  公共技能（搜索/网页/计算/天气/提醒/点歌）不受此约束。
# ------------------------------------------------------------
#  low    = 纯只读：ops 查询、docker_ps/logs、fs_list/read、run_command 只读
#           子集（curl 拒绝）、ssh_run、system_status
#  medium = 日常档（缺省）：low 全部 + 工作区写/删（删除保留确认码）+
#           extract/pack_zip（压缩包解压/打包，标准库实现 0600 落盘）+
#           run_command 全白名单 + service_ctrl/docker_ctrl（restart/start/
#           stop，自保护：拒 bot 自身 unit 与 PG_CONTAINER）+
#           proc_kill（两段确认）+ run_build_script + db_query
#  high   = medium 全部 + run_shell（bash -c 任意命令；最小环境执行不泄漏
#           API key；120s 超时杀进程组 + 输出截断 + 审计日志）
#  脏值告警后回退 medium；改后重启生效；不进 web 写面（安全边界键走 SSH）。
# ============================================================
AGENT_PERMISSION_LEVEL=medium

# ---- 管理员动作类参数（级别制下保留的参数/范围键）----
# proc_kill 两段确认：首次调用只返回确认码与目标 pid，带确认码二次调用才
# 真发信号；拒绝 pid 1 与机器人自身，一次最多 10 个进程。确认码有效期（秒）
AGENT_KILL_CONFIRM_TTL=120
# run_build_script 单次执行超时（秒，默认 300，范围 1~3600）
AGENT_BUILD_TIMEOUT=300

# npm_update（仅管理员，medium+）：登记表制 npm 全局包更新——LLM 只能精确选
# 表内条目（含 GitHub shorthand 如 deepseek-ai/dsh），执行 npm update -g <包>，
# 不能自由拼包名。空 = 整个技能不注册。写入 npm 全局 prefix（尊重 ~/.npmrc 的
# prefix）、不保留旧版本、不可回退——登记即授权（与 AGENT_SSH_HOSTS 同信任模型）。
# 示例（去掉行首 # 启用；M2-线1：默认注释——登记是授权动作，不该被示例值代行）：
# AGENT_NPM_GLOBAL_PACKAGES=deepseek-ai/dsh
# extract/pack_zip（仅管理员，medium+）：压缩包解压/打包（标准库实现，产物 0600）。
# 防解压炸弹上限：条目数（默认 20000，范围 1~1000000）/ 解压或打包总大小 MB
# （默认 1024，范围 1~102400）。脏值告警后回退默认
AGENT_EXTRACT_MAX_ENTRIES=20000
AGENT_EXTRACT_MAX_MB=1024
# db_query（仅管理员，medium+，只读）：连接超时（秒，默认 10）/ 语句超时（毫秒，
# 默认 10000，int-only 防注入）/ 返回行数上限（默认 200，范围 1~5000）。
# DSL 用 DATABASE_URL，未配置 = 功能关闭（绝不连默认库）
AGENT_DB_CONNECT_TIMEOUT=10
AGENT_DB_TIMEOUT_MS=10000
AGENT_DB_MAX_ROWS=200
# 提醒轮询间隔（秒，默认 30）：每 N 秒检查一次有没有到点的提醒，
# 也就是提醒最多晚 N 秒送达；想更准时可调小（如 10），代价是空转更频繁。
AGENT_REMINDER_TICK=30
# 进程统一时区（IANA 名称，如 Asia/Shanghai；或 local = 跟随服务器）：
# cron 触发、归档日键、提醒到期都按它判定；留空 = Asia/Shanghai（默认，不告警）；
# 填了不存在的 IANA 名 = 告警一次并回退服务器本地时区
AGENT_SCHEDULER_TZ=

# ---- 定时内容推送（M7）----
# 与「定时提醒」的区别：提醒的文案是用户自己写的；推送任务由**部署者在
# config.yaml 的 push.jobs 里配置**，到点由 LLM 按 prompt 生成正文
# （LLM 不可用 / 预算熔断时回退 template 兜底文案），经 Sink + 出站节流投递。
# 下面这些 env 覆盖 config.yaml 的 push: 段同名项；任务列表本身只能写在 config.yaml。
AGENT_PUSH_ENABLED=1
# 推送轮询间隔（秒，默认 30，最小 5）
AGENT_PUSH_TICK=30
# 投递失败顺延基数（秒，默认 300）：按指数退避重试，封顶 max_retry_delay
AGENT_PUSH_RETRY_DELAY=300
AGENT_PUSH_MAX_RETRY_DELAY=86400
# 连续失败这么多次（默认 5）就停用该任务并私聊管理员，避免无限重试打脸用户
AGENT_PUSH_MAX_FAILURES=5
# 每个目标（群/私聊）每日最多推送条数（默认 1）——防配置错误把消息刷屏；
# 0 = 不限。超出时跳过本次投递、照常推进下次触发时间
AGENT_PUSH_DAILY_CAP_PER_TARGET=1
# 每日每目标上限的跨进程记账文件：默认不设 = 仅进程内记账（双进程部署或重启后
# 同日可能再发满一轮）；配置后多进程/重启共享同一份计数
# AGENT_PUSH_STATE_FILE=data/push-state.json
# 推送正文长度上限（默认 500 字），同时用作 LLM 的输出上限；0 = 不限
AGENT_PUSH_MAX_CHARS=500

# ---- 主动联系（nudge）----
# 沉默检测器：你多久没说话，它就在合适的时候主动找你聊一句（不是定时公告）。
# 与上面的 push 分界：push 是配置好的 cron 公告；nudge 带人格/记忆/历史，
# 并且**把发出的话写回对话历史**，所以你回复时它接得住上文。
# 目标与全部参数（静默时段、退避节奏、称呼、配额）在 data/nudge.json 里，
# 可在 Web「主动」页修改、每 tick 热读、即时生效；下面三个 env 只做总控。
# 默认关闭（0）——配好 targets 并确认语气后再开。
AGENT_NUDGE_ENABLED=0
# 参数文件路径（默认 data/nudge.json，0600 原子写；损坏时回退默认值并告警）
AGENT_NUDGE_CONFIG=data/nudge.json
# 检查间隔（秒，默认 600，最小 30）：越密越及时，DB 读取也越频繁
AGENT_NUDGE_TICK=600
# 热点候选池 / 去重记录的状态文件（默认 data/nudge-hotspot.json，0600 原子写）：
# 只存"哪些话题提过、候选池里有什么"，丢失的最坏结果是多提一次旧话题
AGENT_NUDGE_HOTSPOT_FILE=data/nudge-hotspot.json

# ---- 长回复投递（分层 + 出站节流）----
# 分层（按「人类不会一次发一大段」重设）：
#   总字数 > FORWARD_MAX(1500)   → 直接发 md 文件（私聊走 file_sender，群聊走群文件上传）
#   段数   <= MERGE_SEGMENTS(3)  → 逐条文本（每段约 SINGLE_MAX=100 字）
#   段数   >  3                  → 合并转发成一张卡片
#   段数   >  MAX_NODES(30)      → 先均匀重打包到至多 MAX_NODES 段，再按上面两条投递
#                                  （一条回复最多 MAX_NODES 条消息，不会退化成几十条连发）
# 发文件**确定失败**才降级回文本分层；结果未知（超时/断连）一律不重发（避免同一内容两遍）。
# 注：SINGLE_MAX / FORWARD_MAX 下限 100，非法值回退默认并打 WARNING；
# 若 FORWARD_MAX 配得比 SINGLE_MAX 小，会被抬到 SINGLE_MAX（分层不能自相矛盾）。
AGENT_REPLY_SINGLE_MAX=100
# 段数**超过**它才合并转发；不超过则逐条发（更像真人，也少占节流额度）
AGENT_REPLY_MERGE_SEGMENTS=3
# 总字数**超过**它就直接发 md 文件（不再发文本/卡片）
AGENT_REPLY_FORWARD_MAX=1500
# 合并转发节点数上限（默认 30；100 字/段时 1500 字约 15 段，需与之匹配）
# 段数超过它时会先「均匀重打包」到至多这么多段，避免退化成几十条连发
AGENT_REPLY_FORWARD_MAX_NODES=30
# 置 0 关闭合并转发，回到逐条发送
AGENT_REPLY_FORWARD=1
# 群聊超长回复是否改发**群文件**（默认 1）。群文件长期留存、可能只有管理员能上传；
# 设 0 则回落到合并转发卡片（私聊不受影响，仍走 file_sender）
AGENT_REPLY_FILE_IN_GROUP=1
# 回复中的 Markdown 表格是否渲染成**图片**发送（默认 1）。QQ 聊天框不渲染 Markdown，
# 表格以纯文本发出时竖线错位、观感极差；渲染依赖中文字体（data/fonts/wqy-zenhei.ttc），
# 无字体时自动降级为纯文本。设 0 关闭
AGENT_TABLE_TO_IMAGE=1
# 合并转发卡片里显示的机器人名字（必须用 bot 自己的身份，不要伪造他人）
AGENT_BOT_NICKNAME=助手
# 出站节流：同一会话两条消息的最小间隔（秒）
AGENT_OUTBOUND_MIN_INTERVAL=1.0
# 账号级最小间隔（秒）：QQ 风控按账号计，多群同时推送也要拉开
AGENT_OUTBOUND_GLOBAL_MIN_INTERVAL=0.4
# 同一会话每窗口（60 秒）的条数上限（软上限，见下）
AGENT_OUTBOUND_PER_MIN=20
# 单次发送最多等待多久（秒，软上限）：宁可冒一点风控风险也不让提醒无限期卡住。
# 只约束「窗口条数」分量；最小间隔（per-target / 账号级）始终完整执行，不受它限制
AGENT_OUTBOUND_MAX_WAIT=10
# 会话桶数量上限：超出后按插入顺序淘汰未持锁的旧会话桶（其窗口记录丢弃）
AGENT_OUTBOUND_MAX_TARGETS=4096

# ============================================================
#  并发与资源上限（本批审查新增）
# ============================================================
# 单个防抖窗口最多合并多少条消息：达到即立即结算本批并开新窗口（不丢内容、防单请求膨胀）
AGENT_DEBOUNCE_MAX_PARTS=20
# 全进程同时进行的 LLM 轮次上限（不同会话窗口同时到期时的闸门）
AGENT_MAX_CONCURRENT_TURNS=4
# 单回合引擎超时（秒，默认 180；0 = 不限制）：超时的回合按失败回复，不挂住会话
AGENT_TURN_TIMEOUT=180
# 最近图片缓存字节预算（默认 64MB；0 = 不限）。缓存的是 base64 data URI，体积约为原图 1.37 倍
AGENT_RECENT_IMAGE_BYTES=67108864
# 停机时等待防抖 flush 完成的上限秒数（默认 30；0 = 不设限）。
# flush 出去的窗口要过全局 LLM 并发闸门，在途回复挂读超时会让 flush 排队——
# systemd 短超时会 SIGKILL，反而全丢；到点放弃剩余窗口（记 ERROR）更可控。
AGENT_SHUTDOWN_FLUSH_TIMEOUT=30

# ============================================================
#  帮助（「帮助」/aihelp 指令：Pillow 渲染菜单图片发到 QQ）
# ============================================================
# 0 = 关闭图片菜单，恒以文本回复；缺 Pillow/中文字体时也会自动退回文本
AGENT_HELP_IMAGE=1

# ============================================================
#  本机概览（被「戳一戳」时回一张当前机器概览图）
#
#  数据取自同级 dashboard 项目的**只读 API**，图由 bot 本机用 Pillow 重绘
#  （配色对齐看板概览页；布局是**竖屏简版**——只看核心指标，不搬整页）。
#  链路：
#    看板 /api/overview + /api/series → 本模块渲染 → QQ 图片消息
#
#  在 dashboard 页面侧栏「账号 → 新建只读令牌」生成 dshk_… 填进
#  AGENT_DASHBOARD_TOKEN 即可（令牌**只能读**，bot 不必存账号密码，
#  改看板密码也不会被踢）。不填 = 整个功能不响应（fail-closed）。
# ============================================================
# 看板地址（默认同机部署）。必须是 http(s)://主机[:端口]
AGENT_DASHBOARD_URL=http://127.0.0.1:8282
# 只读令牌（dshk_…）。留空 = 未配置，戳一戳回一句提示且不发图
AGENT_DASHBOARD_TOKEN=
# 单次看板请求墙钟上限（秒，默认 8；0/脏值回退默认）
AGENT_DASHBOARD_TIMEOUT=8
# 0 = 关闭戳一戳响应（默认开启）
AGENT_POKE_ENABLED=1
# 同一会话的冷却秒数（默认 30；0 = 不限）。
# 响应范围与门槛：**只给 SUPERUSERS**，且群聊还必须在 ALLOWED_GROUPS 白名单里——
# 概览图含主机名、最忙进程名、磁盘/网卡/服务摘要等本机信息，不放给任意群友。
AGENT_POKE_COOLDOWN=30
# 人格成长：每个用户的对话轮数计数达该阈值后，后台回顾历史并 LLM 提炼
# 「关系成长」提议，私聊推送管理员确认（回复「确认成长 XXXXXXXX」）后写入；
# 成长层总开关（0 = 关闭；与 INTERVAL=0 等价，改后需重启）
AGENT_PERSONA_GROWTH_ENABLED=1
# 成长层与 persona md 分层注入，per-user 独立演化。
# 0 = **关闭**该功能（脏值告警后回退 30）
AGENT_PERSONA_GROWTH_INTERVAL=30
# 成长层注入 system prompt 的字符上限（默认 500）。成长层与人格段争的是同一件
# 事（"怎么说话"）：人格 md 是叙事型长文、成长层是指令密度更高的短文本，调小
# 可直接降低成长层对人格的覆盖面积；小于 50 由构造层兜底抬回 50。
AGENT_PERSONA_GROWTH_MAX_CHARS=500
# embedding 远程故障的退避重试（429 限流 / 5xx / 超时 / 断连 → 重发而非降级 hash）：
# 重试次数与基础间隔（秒，间隔随次数递增）；重试耗尽或 4xx 配置错误 → 响亮失败
EMBEDDING_RETRY_COUNT=5
EMBEDDING_RETRY_BASE_DELAY=60
# 量化提示：默认 5 次 × 60s 基础退避 = 最坏 900s（仅批量摄取路径适用）。
# 交互路径（记忆召回/事实抽取）另有一套更短的预算，避免一次普通发言被挂住：
EMBEDDING_INTERACTIVE_RETRY_COUNT=1
EMBEDDING_INTERACTIVE_BUDGET=30
# 启动期维度探测的墙钟上限（秒）：探测失败/超时都不阻塞启动，回退配置维度
EMBEDDING_PROBE_TIMEOUT=10

# ============================================================
#  点歌/放歌（群语音）：LLM skill 触发（模型判断是否放歌）
#
#  例：「云崽 点歌 海阔天空」或 @机器人 放首歌听听（唤醒后由模型决定调
#  play_music skill，不要求固定子命令）
#  整条链路默认**关闭**：AGENT_MUSIC_API_URL 未配置就不注册 skill，
#  消息照常走普通聊天（对核心零影响）。三条 env 齐备才启用：
#    AGENT_MUSIC_API_URL + NAPCAT_HTTP_URL + (pysilk 与 PATH 里有 ffmpeg)
#
#  安全不靠模型自觉：handler 内有群白名单 / 私聊仅 superuser /
#  歌名校验（疑问句与泛称直接拒绝，不烧冷却）/ 账号级冷却四道硬闸。
# ============================================================
# NeteaseCloudMusicApi 基址（自建，如 http://127.0.0.1:16300）。
# 留空 = 关闭点歌功能。
AGENT_MUSIC_API_URL=
# 允许点歌的群号（逗号分隔）。**留空 = 全部拒绝**，且**不继承** ALLOWED_GROUPS
# ——以后往 ALLOWED_GROUPS 加群不会顺带获得点歌能力。
AGENT_MUSIC_ALLOWED_GROUPS=
# 音频下载的域名后缀白名单（逗号分隔，只允许 https）。默认网易云 CDN。
AGENT_MUSIC_AUDIO_HOSTS=music.126.net
# 单次下载上限（MB）。最终转成语音，超过上限直接拒绝。
AGENT_MUSIC_MAX_DOWNLOAD_MB=20
# 时长上限（秒）。超过就不发语音（QQ 对长语音不友好；实测 4:28 可发）。
# 0 = 不限制；负值/脏值回退本默认值。
AGENT_MUSIC_MAX_SECONDS=300
# 账号级冷却（秒）：同一时间只允许一条语音在途，避免 highway 上传互相排队。
# 0 = 关闭冷却。
AGENT_MUSIC_COOLDOWN=15
# 点歌总开关（0 = 关闭；skill 被调用时直接返回"点歌功能已关闭"，不发起下载）
AGENT_MUSIC_ENABLED=1
# 点歌意图别名（逗号分隔）。skill 化后**不再是硬触发词**，只作为 skill
# 描述里的提示，告诉模型"用户说这些词时该调 play_music"。
AGENT_MUSIC_COMMANDS=点歌,放歌
# 落盘音频缓存目录与配额（MB，超出按 mtime 最旧优先清理）。
AGENT_MUSIC_CACHE_DIR=data/cache/music
AGENT_MUSIC_CACHE_MB=200

# ============================================================
#  群聊发言榜 + 词云（opt-in，默认关闭）
#  按群统计「谁话多 / 大家在聊什么」：/发言榜、/词云 群命令 +
#  每周一 9:00 自动周报（渲染成图片发送）。
#  隐私口径：只统计 ALLOWED_GROUPS 白名单群（可用
#  AGENT_GROUP_STATS_ALLOWED_GROUPS 进一步收窄）；**只落聚合**
#  （每用户每日条数/字数/小时直方图 + 分词词频），消息原文不落任何存储；
#  合并转发消息整条不采集；默认保留 35 天，每日清理。
# ============================================================
# 总开关：0=关闭（默认）。未配 DATABASE_URL 时统计仅进程内有效，重启清零。
AGENT_GROUP_STATS=0
# 统计采集群白名单（逗号分隔群号）：留空 = 继承 ALLOWED_GROUPS。
# 只能收窄、不能越界——不在 ALLOWED_GROUPS 的群会被忽略并告警。
# 适合「聊天白名单有 6 个群，但只想给其中 3 个群做发言榜」的场景。
AGENT_GROUP_STATS_ALLOWED_GROUPS=
# 聚合落库周期（秒）：也是榜单/词云的数据滞后上限。
AGENT_GROUP_STATS_FLUSH_SECONDS=30
# 保留天数（默认 5 周：够「上周对比」+ 冗余）。
AGENT_GROUP_STATS_RETENTION_DAYS=35
# 榜单人数（1..20）。
AGENT_GROUP_STATS_TOP_N=5
# 词云词数上限（10..500）。
AGENT_GROUP_STATS_WORDS=80
# 周报最低群友条数：不足不发（避免新群/死群每周推空气周报）。
AGENT_GROUP_STATS_MIN_MSGS=20
# 周报时间（5 段 cron，时区随 AGENT_SCHEDULER_TZ，默认 Asia/Shanghai）。
# 设为空串 = 只保留群命令，不自动推送。
AGENT_GROUP_STATS_CRON=0 9 * * 1
# 同群命令冷却（秒），防刷屏。
AGENT_GROUP_STATS_CMD_COOLDOWN=30
# 追加停用词（逗号分隔），叠加内置停用词表。
AGENT_GROUP_STATS_STOPWORDS=
# 周报推送白名单（逗号分隔群号）：cron 到点只推给这些群。**空 = 一条都不推**
# （fail-closed：忘记配 = 静默不推）。只管推送——采集与 /发言榜、/词云、
# my_group_review skill 仍按 ALLOWED_GROUPS（白名单须是 ALLOWED_GROUPS 的子集）。
AGENT_GROUP_STATS_WEEKLY_GROUPS=
# LLM 个人点评（my_group_review skill，用户说「点评我一下」时由 LLM 调用）：
# 最低条数门槛（低于不评）、评语长度上限、per-user 冷却秒数。
# 生成走预算硬闸门与不可信内容围栏；同周评语落库缓存，重复查看零 LLM 成本。
AGENT_GROUP_STATS_REVIEW_MIN_MSGS=10
AGENT_GROUP_STATS_REVIEW_MAX_CHARS=80
AGENT_GROUP_STATS_REVIEW_COOLDOWN=30
# ============================================================
#  群消息原文归档（AGENT_GROUP_ARCHIVE，独立 opt-in，默认关）
#  把白名单群每条非 bot 消息（含合并转发行，但不展开转发内容）落 PG 表
#  group_messages_raw，保留 30 天。用途：对账（从原文重算聚合）、回溯、
#  点评增强（本人高频词/转发次数/发图次数/被引用次数/代表性原句）。
#  注意：与"只存聚合"的统计不同，这是**消息原文**——隐私口径更重，
#  仅 ALLOWED_GROUPS 白名单群（空集 = 不归档，fail-closed）、opt-in 开启；
#  bot 自己的消息不存。
#  仅 PG：无 DATABASE_URL 或 PG init 失败 = 功能不可用（不降级内存）。
#  停机 flush 不丢；kill -9 丢 ≤ FLUSH_SECONDS（批量落库周期）。
# ============================================================
AGENT_GROUP_ARCHIVE=0
AGENT_GROUP_ARCHIVE_RETENTION_DAYS=30
AGENT_GROUP_ARCHIVE_FLUSH_SECONDS=30
AGENT_GROUP_ARCHIVE_BUFFER_MAX=50000
