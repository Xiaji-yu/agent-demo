[Unit]
Description=Mirror agent-demo backups to VPS over WireGuard
Documentation=file:///home/xiaji/code/agent-demo/docs/operations.md
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
User=xiaji
Group=xiaji
WorkingDirectory=/home/xiaji/code/agent-demo
# 走 WG 内网 10.10.0.1，不暴露公网 SSH；9GB 目录闸门 + 30 天保留。
Environment="MIRROR_HOST=vps-backup"
Environment="MIRROR_ROOT=/srv/backup/agent-demo"
Environment="KEEP_DAYS=30"
Environment="MAX_GB=9"
ExecStart=/home/xiaji/code/agent-demo/scripts/backup_mirror.sh
TimeoutStartSec=30min
