# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
*.manifest
*.spec

# Virtual environment
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment / secrets
.env
.env.local
.env.*.local
# JSON 主配置与 web 受控写面落点（2026-10-28 起配置从 .env 换成 config/agent.json）。
# 装着与 .env 同一批凭据（LLM_API_KEY / 协议端 token / QQ 号），同纪律绝不入库；
# 它们是 compose init 在项目目录生成的普通文件，不再是 dotfile，.env 条目盖不住
config/agent.json
config/agent.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Node (if any scripts added later)
node_modules/
package-lock.json
yarn.lock

# Database volumes / local data
pgdata/
data/sessions/
data/cache/
# 聊天记录归档与数据库备份：含隐私内容，绝不入库
data/archive/
data/backups/
# 旧版多 LLM provider 配置（含 API key）。2026-10-28 起 provider 已并进
# config/agent.json 的 LLM_PROVIDERS 数组；此文件仅在从旧版升级时做一次性迁移读取。
data/llm-providers.json
data/state/llm-providers.json
# 多搜索源配置（含 API key），运行期生成，绝不入库
data/search-providers.json
# 主动联系配置（含目标 QQ 号）与热点候选池状态，运行期生成，绝不入库
data/nudge.json
data/nudge-hotspot.json
# 2FA secret（TOTP 密钥），运行期生成，绝不入库
data/2fa-secret.json

# 人格：只跟踪仓库内置（assistant / fortune_teller），本地自定义一律不入库
agentcore/personas/*.md
!agentcore/personas/assistant.md
!agentcore/personas/fortune_teller.md

# 个人脱敏词表（实际出现的人名/昵称），含隐私，不入库
data/privacy/

# 成本用量账本与运行日志（含聊天明文，绝不入库）
data/budget/
data/logs/

# LLM 沙箱工作区（本地临时/缓存）
# SOUL.md / personas/ / cron/ 是**配置**（OpenClaw 兼容），要入库——默认人格与
# 定时任务随仓库走，换机器/重建镜像都有；其余运行期产物仍忽略。
data/workspace/*
!data/workspace/SOUL.md
!data/workspace/personas/
!data/workspace/cron/

# 知识库样例语料（本地自备，一律不入库）
data/kb_samples/*
!data/kb_samples/.gitkeep

# Mimosa 安全钩子的本地扫描状态（工具自产，不入库）
.mimosa/
