# Environment / secrets
.env
.env.local
.env.*.local
# 与 .env 同纪律：config/ 下是 deploy.py 首启自举的凭据载体（LLM key / 协议端 token）
config/agent.json
config/agent.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Node (if any scripts added later)
node_modules/
package-lock.json
yarn.lock

# Database volumes / local data
pgdata/
data/sessions/
data/cache/
# 聊天记录归档与数据库备份：含隐私内容，绝不入库
data/archive/
data/backups/
# 多 LLM provider 配置（含 API key），运行期生成，绝不入库
data/llm-providers.json
# 多搜索源配置（含 API key），运行期生成，绝不入库
data/search-providers.json
# 主动联系配置（含目标 QQ 号）与热点候选池状态，运行期生成，绝不入库
data/nudge.json
data/nudge-hotspot.json
# 2FA secret（TOTP 密钥），运行期生成，绝不入库
data/2fa-secret.json

# 人格：只跟踪仓库内置（assistant / fortune_teller），本地自定义一律不入库
agentcore/personas/*.md
!agentcore/personas/assistant.md
!agentcore/personas/fortune_teller.md

# 个人脱敏词表（实际出现的人名/昵称），含隐私，不入库
data/privacy/

# 成本用量账本与运行日志（含聊天明文，绝不入库）
data/budget/
data/logs/

# LLM 沙箱工作区（本地临时/缓存）
data/workspace/

# 知识库样例语料（本地自备，一律不入库）
data/kb_samples/*
!data/kb_samples/.gitkeep

# Mimosa 安全钩子的本地扫描状态（工具自产，不入库）
.mimosa/

# cron 任务与用户人格（2026-11-01 P2 批，AC-group-guest-mode D2/D3）：
# 含真实投递目标/个人内容，不入库（H2 教训）；模板在 docs/examples/ 与
# agentcore/personas/templates/。运行态 sidecar（state.json）同目录一并忽略
data/cron/
data/personas/
# 容器状态重定向与可选挂载（批 B 引入；含 TOTP secret/搜索 key/pg_dump 落点）
data/state/
data/mirror/
data/ssh/
# 出站投递记账 / 打扰预算记账：默认在 data/state/ 下（容器形态），但非容器部署
# 可直接用 data/ 根路径（agentcore/outbox.py:34 DEFAULT_FILE 之外的 env 覆盖值），
# 含真实投递目标 ⇒ 两个位置都要忽略（2026-11-03 P2/P3 补）
data/outbox.jsonl
data/notify-budget.json
# 「重启完毕」回执与 push 旧记账文件：代码默认值就在 data/ 根
data/reboot-notice.json
data/push-state.json
