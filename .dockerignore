# 构建上下文里只留运行必需的东西。
#
# 两个安全项：
# - .env 绝不进镜像（凭据会烤进层，推仓库即泄漏）
# - data/* 只放行 fonts（render/fonts.py 按它解析字体）；budget/archive/logs/
#   backups/llm-providers.json 等既是运行期产物又含聊天明文与密钥

# 版本控制 / 本地环境 / 密钥
.git
.gitignore
.venv
venv
env
.env
# .env.* 挡的是 .env.local 之类；.env.example 是 compose init 的 .env 生成模板，
# 镜像内零密钥（真实 .env 仍被上一行挡着），必须放行，否则 COPY 静默缺件
.env.*
!.env.example
.mimosa

# 测试与工具产物
.pytest_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
__pycache__
*.py[cod]
*.so

# data/ 仅放行受版本控制的 fonts；skills 与 kb_samples 由 compose 挂载
# （用户自定义技能/语料不该烤进镜像）
data/*
!data/fonts

# 文档只留 README.md（hatchling 的 readme 字段要读它）
*.md
!README.md
docs
review
tests
perf
.github
dist
build

# 脚本只留容器入口与 compose 引导（init 子命令）
scripts/*
!scripts/docker-entrypoint.sh
!scripts/compose_init.py
